{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.2.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "icons": {
    "16": "res/icon-16.png",
    "32": "res/icon-32.png",
    "48": "res/icon-48.png",
    "128": "res/icon-128.png"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "res/icon-16.png",
      "32": "res/icon-32.png",
      "48": "res/icon-48.png",
      "128": "res/icon-128.png"
    },
    "default_title": "__MSG_extensionName__"
  },
  "background": {
    "service_worker": "core/bg.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core/err.js", "core/prompts.js", "core/perf.js", "core/imgproc.js", "ui/overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["ui/overlay.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
